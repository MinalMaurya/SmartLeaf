        <!-- About Activity Content -->
        <string name="about_title">🌿 സ്മാർട്ട്ലീഫ് - AI-ഓടിക്കുന്ന ഫസ്ൽ രോഗ പോലെ കണ്ടെത്തൽ</string>
        <string name="about_intro">സ്മാർട്ട്ലീഫ് കൃഷിക്കാരും ഉദ്യാനവാദികൾക്കും പ്രത്യേകമായി രൂപകൽപ്പനചെയ്ത ഒരു സ്വതന്ത്ര മോബൈൽ ആപ്ലിക്കേഷനാണ്. ഇത് ഇലയുടെ ഫോട്ടോ എടുത്ത് ഫസ്ൽ രോഗ അനുമാനിക്കാൻ നിങ്ങളെ സാഹായ്യം ചെയ്യുന്നു. അത്യാധുനിക AI സാങ്കേതികത ഉപയോഗിച്ച്, അപ്ലിക്കേഷൻ ഫോട്ടോ വിശകലനം ചെയ്ത് നിങ്ങളുടെ മനോനഷ്ടമായ ഭാഷയിൽ ലളിത നിർദ്ദേശങ്ങൾ നൽകുന്നു.</string>

        <string name="about_vision_title">🌟 നമ്മുടെ കാഴ്ച</string>
        <string name="about_vision_text">കൃഷിയെ ലളിതയും നാണയുരാമാകാനും ചെയ്യൽ. സാങ്കേതികത കർഷകരെ അവരുടെ ഫസ്ൽ ആരോഗ്യം വിതരണം ചെയ്യാനും വരുമാനം വർദ്ധിപ്പിക്കാനും സാഹായ്യം ചെയ്യാൻ കഴിയുമെന്ന് നമ്മൾ വിശ്വസിക്കുന്നു.</string>

        <string name="about_mission_title">🎯 നമ്മുടെ ലക്ഷ്യം</string>
        <string name="about_mission_text">• കർഷകരെ ഫസ്ൽ രോഗ വേഗം കണ്ടെത്താൻ സാഹായ്യം ചെയ്യുന്നു\n• നിരവധി ഭാഷകളിൽ പരിഹാരം നൽകുന്നു\n• ഫസ്ൽ നാശത്തിൽ നിന്ന് പരിരക്ഷിക്കുന്നു കൂടാതെ ഉത്പാദനം വർദ്ധിപ്പിക്കുന്നു\n• സമകാലീന AI സാങ്കേതികത ഗ്രാമീണ മേഖലകളിൽ ലളിത വഴിയിൽ കൊണ്ടുവരുന്നു\n• പ്രത്യേക കർഷകന്റെ വേണ്ടിയുള്ള ഫസ്ൽ ആരോഗ്യ നിരീക്ഷണം പ്രവേശ്യം ലളിതയാക്കുന്നു</string>

        <string name="about_goals_title">🎯 നമ്മുടെ ലക്ഷ്യങ്ങൾ</string>
        <string name="about_goals_text">• കർഷകരെ അവരുടെ സ്മാർട്ട്ഫോണ് ഉപയോഗിച്ച് ഫസ്ൽ ആരോഗ്യം പരിശോധിക്കാൻ കഴിവാക്കുന്നു\n• 90% ത്തിൽ കൂടുതൽ കൃത്യത നൽകുന്നു\n• ഫസ്ൽ രോഗങ്ങൾ തടയാൻ വ്യക്തമായ ഘട്ടങ്ങൾ നൽകുന്നു\n• നിരവധി പ്രാദേശിക ഭാഷകളിൽ സഹായത നൽകുന്നു\n• AI മാതൃക നിരന്തരം ഉന്നയിക്കുന്നു</string>

        <string name="about_features_title">✅ സ്മാർട്ട്ലീഫ് ചെയ്യാൻ കഴിയുന്നത്</string>
        <string name="about_features_text">• തൈതൽ ഇലയുടെ ഫോട്ടോയിൽ നിന്ന് രോഗ അനുമാനിക്കുന്നു\n• വിശദ രോഗ വിവരം നൽകുന്നു\n• ലളിത ഉപചാരം നിർദ്ദേശിക്കുന്നു\n• നിരവധി ഭാഷകളിൽ സഹായത നൽകുന്നു\n• നോഥെയ്ക്കും പൂർണ്ണ സ്വതന്ത്രതയും ലളിതയും നൽകുന്നു\n• ഇന്റർനെറ്റ് ഇല്ലാതെ പ്രവർത്തിക്കുന്നു\n• സ്കാൻ ഇതിഹാസം സംരക്ഷിക്കുന്നു</string>

        <string name="about_why_title">📖 നമ്മൾ ഇത് നിർമ്മിച്ചത് എന്തിനാണ്</string>
        <string name="about_why_text">ഓരോ വർഷവും നിരവധി കർഷകർ അവരുടെ ഫസ്ൽ നഷ്ടപ്പെടുകയാണ് കാരണം അവർ രോഗ വേഗം അനുമാനിക്കാൻ കഴിയില്ല. പരമ്പരാഗത രീതിയിൽ വിദ്വാൻ ഉപദേശം വില്പിക്കൾ വിറ്റാണ് സമയ പാഴായ. സ്മാർട്ട്ലീഫ് വേഗ, കൃത്യത കൂടാതെ പ്രവേശ്യമായ അനുമാനത്തിനായി നിർമ്മിതമാണ്.</string>

        <string name="about_helps_title">🔹 ഇത് കർഷകരെ സാഹായ്യം ചെയ്യുന്ന കേരളം</string>
        <string name="about_helps_text">• രോഗ വേഗം അനുമാനിച്ച് ഫസ്ൽ സംരക്ഷിക്കുന്നു\n• ഗ്രാമീണ സ്ഥലങ്ങളിൽ പ്രവർത്തിക്കുന്നു\n• പ്രാദേശിക ഭാഷകൾ സഹായിക്കുന്നു\n• കർഷകരുടെ വരുമാനം വർദ്ധിപ്പിക്കാൻ സാഹായ്യം ചെയ്യുന്നു\n• വില്പിക്കൾ ഉപദേശകരുടെ ആശ്രയത കുറയ്യ്യുന്നു\n• 24/7 നിരീക്ഷണ സൌകര്യ നൽകുന്നു\n• കർഷകരെ അറിവ് നൽകുന്നു</string>

        <string name="about_commitment_title">🌱 നമ്മുടെ വാങ്ങൽ</string>
        <string name="about_commitment_text">സ്മാർട്ട്ലീഫ് കർഷകരുടെ സന്തുഷ്ടിയിലേക്ക് കമ്മിറ്റുമാണ്. നമ്മൾ നിയമിത വിധിയിൽ മാതൃക അപ്ഡേറ്റ് ചെയ്ത് ഉപയോഗകരുടെ അഭിപ്രായ കേട്ടി.</string>

        <string name="about_community_title">💚 നമ്മുടെ സമൂഹത്തിൽ സേരിക്കുന്നു</string>
        <string name="about_community_text">സ്മാർട്ട്ലീഫ് കുടുംബിന്റെ ഭാഗമായ കൃഷിയെ സ്മാർട്ട് ചെയ്യാൻ സാഹായ്യം ചെയ്യുന്നു. നിങ്ങളുടെ അഭിപ്രായം നമ്മൾ ഉന്നയിപ്പിക്കാൻ സാഹായ്യം ചെയ്യുന്നു।</string>
