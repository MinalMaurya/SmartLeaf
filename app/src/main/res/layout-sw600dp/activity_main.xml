<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.MainActivity"
    tools:ignore="HardcodedText,ImageContrastCheck,TextContrastCheck">

    <!-- Toolbar at top -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/green"
        app:title="@string/app_name"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_leaf_logo"
        app:navigationIconTint="@android:color/white" />

    <!-- Navigation Rail on the left side -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navigation_rail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        app:menu="@menu/bottom_nav_menu"
        android:background="@android:color/white"
        app:itemIconTint="#4CAF50"
        app:itemTextColor="#4CAF50" />

    <!-- Main content area -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="80dp"
        android:layout_marginTop="?attr/actionBarSize"
        android:orientation="vertical">

        <!-- Main scrolling content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- Welcome Header -->
                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_home"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="20dp" />

                <!-- Tips Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Watering & Soil -->
                        <TextView
                            android:id="@+id/card_tips_water_soil_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_water_soil_title"
                            android:textColor="#2E7D32"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/card_tips_water_soil_tip1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_water_soil_tip1"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/card_tips_water_soil_tip2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_water_soil_tip2"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EAEAEA"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <!-- Sun & Nutrition -->
                        <TextView
                            android:id="@+id/card_tips_sun_nutrition_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_sun_nutrition_title"
                            android:textColor="#2E7D32"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/card_tips_sun_nutrition_tip1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_sun_nutrition_tip1"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/card_tips_sun_nutrition_tip2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_sun_nutrition_tip2"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EAEAEA"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <!-- Pests & Hygiene -->
                        <TextView
                            android:id="@+id/card_tips_pests_hygiene_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_pests_hygiene_title"
                            android:textColor="#2E7D32"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/card_tips_pests_hygiene_tip1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_pests_hygiene_tip1"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/card_tips_pests_hygiene_tip2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_pests_hygiene_tip2"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#EAEAEA"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <!-- Harvest & Storage -->
                        <TextView
                            android:id="@+id/card_tips_harvest_storage_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_harvest_storage_title"
                            android:textColor="#2E7D32"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/card_tips_harvest_storage_tip1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_harvest_storage_tip1"
                            android:textColor="#424242"
                            android:textSize="15sp"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/card_tips_harvest_storage_tip2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_tips_harvest_storage_tip2"
                            android:textColor="#424242"
                            android:textSize="15sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_quick_scan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/scan_now"
        android:src="@drawable/ic_scan"
        app:backgroundTint="#FFA726"
        app:tint="@android:color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
