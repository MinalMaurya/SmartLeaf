<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.AboutActivity">

    <!-- AppBar with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/green"
            app:title="@string/app_name"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/backgroundleaf"
        android:scaleType="centerCrop"
        android:contentDescription="@string/background_image"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Semi-transparent overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33FFFFFF"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Card with Logo and Title -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FEFEFE"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <!-- Logo -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvLogo"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="#E8F5E9">

                        <ImageView
                            android:id="@+id/ivLogo"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_gravity="center"
                            android:src="@drawable/logo"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/app_logo" />

                    </androidx.cardview.widget.CardView>

                    <!-- App Name -->
                    <TextView
                        android:id="@+id/tvAppName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name_smartleaf"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="16dp" />

                    <!-- Tagline -->
                    <TextView
                        android:id="@+id/tvTagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tagline"
                        android:textSize="14sp"
                        android:textColor="#546E5B"
                        android:fontFamily="sans-serif"
                        android:textAlignment="center"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- About Content Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAboutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FEFEFE"
                app:strokeWidth="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- About Content Text -->
                    <TextView
                        android:id="@+id/aboutContentTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_content_loading"
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="#424242"
                        android:fontFamily="sans-serif"
                        android:textIsSelectable="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Developers Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDevelopers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FEFEFE"
                app:strokeWidth="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Developers Heading -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/ivDevIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_team"
                            app:tint="#4CAF50"
                            android:contentDescription="@string/developers_icon" />

                        <TextView
                            android:id="@+id/tvDevelopersHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/developed_by"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/dividerDev"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="16dp" />

                    <!-- Developer 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivDev1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person"
                            app:tint="#4CAF50"
                            android:contentDescription="@string/developer_icon" />

                        <TextView
                            android:id="@+id/tvDev1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/developer_1"
                            android:textColor="#424242"
                            android:textSize="24sp"
                            android:fontFamily="sans-serif"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <!-- Developer 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivDev2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person"
                            app:tint="#4CAF50"
                            android:contentDescription="@string/developer_icon" />

                        <TextView
                            android:id="@+id/tvDev2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/developer_2"
                            android:textSize="24sp"
                            android:textColor="#424242"
                            android:fontFamily="sans-serif"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <!-- Developer 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivDev3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person"
                            app:tint="#4CAF50"
                            android:contentDescription="@string/developer_icon" />

                        <TextView
                            android:id="@+id/tvDev3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/developer_3"
                            android:textSize="24sp"
                            android:textColor="#424242"
                            android:fontFamily="sans-serif"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Version Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F1F8F4"
                app:strokeWidth="0dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivVersionIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info"
                        app:tint="#4CAF50"
                        android:contentDescription="@string/version_icon" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/version_1_0"
                        android:textSize="14sp"
                        android:textColor="#2E7D32"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/last_updated"
                        android:textSize="12sp"
                        android:textColor="#546E5B"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
