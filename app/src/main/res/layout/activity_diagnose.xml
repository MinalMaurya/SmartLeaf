<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.activities.DemoDiagnoseActivity">

    <!-- Background with overlay -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/backgroundleaf"
        android:scaleType="centerCrop"
        android:alpha="0.15"
        android:contentDescription="@string/background_image" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Header Section -->
            <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- Icon -->
                <ImageView
                    android:id="@+id/ivDiagnoseIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_diagnose"
                    app:tint="#4CAF50"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:contentDescription="@string/diagnose_icon" />

                <!-- Title -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_diagnosis"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintTop_toTopOf="@id/ivDiagnoseIcon"
                    app:layout_constraintStart_toEndOf="@id/ivDiagnoseIcon"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="12dp" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_leaf_image"
                    android:textSize="13sp"
                    android:textColor="#757575"
                    android:fontFamily="sans-serif"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle"
                    app:layout_constraintStart_toEndOf="@id/ivDiagnoseIcon"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Image Upload Card -->
        <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvImageUpload"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/cvHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Image Preview Container -->
            <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvImagePreview"
            android:layout_width="0dp"
            android:layout_height="280dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F5F5F5"
            app:strokeWidth="2dp"
            app:strokeColor="#E0E0E0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Image Preview -->
                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/leaf_preview" />

                <!-- Placeholder when no image -->
                <LinearLayout
                    android:id="@+id/llPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_image_placeholder"
                        android:alpha="0.3"
                        app:tint="#9E9E9E"
                        android:contentDescription="@string/upload_placeholder" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_image_selected"
                        android:textSize="14sp"
                        android:textColor="#9E9E9E"
                        android:fontFamily="sans-serif"
                        android:textAlignment="center"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

                <!-- Loading Overlay -->
                <FrameLayout
                    android:id="@+id/flLoadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC000000"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ProgressBar
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:indeterminateTint="#4CAF50" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/analyzing"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>

                </FrameLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Upload Button -->
        <com.google.android.material.button.MaterialButton
        android:id="@+id/pickImageBtn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/select_leaf_image"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:letterSpacing="0.05"
        app:cornerRadius="12dp"
        app:backgroundTint="#4CAF50"
        app:elevation="4dp"
        app:icon="@drawable/ic_upload"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/cvImagePreview"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

    <!-- Results Section -->
<LinearLayout
android:id="@+id/llResults"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:orientation="vertical"
android:visibility="gone"
app:layout_constraintTop_toBottomOf="@id/cvImageUpload"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"
android:layout_marginTop="20dp">

<!-- Primary Result Card -->
<com.google.android.material.card.MaterialCardView
android:id="@+id/cvPrimaryResult"
android:layout_width="match_parent"
android:layout_height="wrap_content"
app:cardCornerRadius="16dp"
app:cardElevation="6dp"
app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="16dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_result"
            app:tint="#4CAF50"
            android:contentDescription="@string/result_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnosis_result"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp" />

    </LinearLayout>

    <!-- Primary Result Text -->
    <TextView
        android:id="@+id/primaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/awaiting_results"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#424242"
        android:fontFamily="sans-serif" />

</LinearLayout>

</com.google.android.material.card.MaterialCardView>

    <!-- Details Card -->
    <com.google.android.material.card.MaterialCardView
    android:id="@+id/cvDetails"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="16dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="20dp">

<!-- Header with Icon -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_list"
        app:tint="#2196F3"
        android:contentDescription="@string/details_icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detailed_analysis"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="10dp" />

</LinearLayout>

<!-- Details Text -->
<TextView
    android:id="@+id/detailsText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/awaiting_details"
    android:textSize="15sp"
    android:lineSpacingExtra="4dp"
    android:textColor="#424242"
    android:fontFamily="sans-serif" />

</LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Alternatives Card -->
    <com.google.android.material.card.MaterialCardView
    android:id="@+id/cvAlternatives"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="24dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="20dp">

<!-- Header with Icon -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_alternative"
        app:tint="#FF9800"
        android:contentDescription="@string/alternatives_icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alternative_diagnoses"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="10dp" />

</LinearLayout>

<!-- Alternatives Text -->
<TextView
    android:id="@+id/alternativesText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/awaiting_alternatives"
    android:textSize="15sp"
    android:lineSpacingExtra="4dp"
    android:textColor="#424242"
    android:fontFamily="sans-serif" />

</LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
