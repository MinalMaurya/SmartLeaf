        <!-- About Activity Content -->
        <string name="about_title">🌿 ಸ್ಮಾರ್ಟ್‌ಲೀಫ್ - AI-ಚಾಲಿತ ಫಸಲ್ ರೋಗ ಸನ್ನಿವೇಶನ</string>
        <string name="about_intro">ಸ್ಮಾರ್ಟ್‌ಲೀಫ್ ರೈತರು ಮತ್ತು ಮಾರುಗನ್ನಲು ವಿಶೇಷವಾಗಿ ಕಲ್ಪಿಸಿದ ಒಂದು ಉಚಿತ ಮೊಬೈಲ್ ಅಪ್ಲಿಕೇಶನ್ ಆಗಿದೆ. ಇದು ಎಲೆಯ ಚಿತ್ರ ತೆಗೆದುಕೊಂಡು ಫಸಲ್ ರೋಗುಗಳನ್ನು ಗುರುತಿಸಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಅತ್ಯಾಧುನಿಕ AI ತಂತ್ರಜ್ಞಾನವನ್ನು ಬಳಸಿ, ಅಪ್ಲಿಕೇಶನ್ ಚಿತ್ರವನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತದೆ ಮತ್ತು ನಿಮ್ಮ ಆದ್ಯತೆಯ ಭಾಷೆಯಲ್ಲಿ ಸರಳ ಸೂಚನೆಗಳನ್ನು ನೀಡುತ್ತದೆ.</string>

        <string name="about_vision_title">🌟 ನಮ್ಮ ದೃಷ್ಟಿ</string>
        <string name="about_vision_text">ಕೃಷಿಯನ್ನು ಸರಳ ಮತ್ತು ಸ್ಮಾರ್ಟ್ ಮಾಡುವುದು. ತಂತ್ರಜ್ಞಾನವು ರೈತರನ್ನು ಅವರ ಫಸಲ್ ಆರೋಗ್ಯವನ್ನು ಜಾಗರಿತ ಮಾಡಲು ಮತ್ತು ಆದಾಯ ಹೆಚ್ಚಿಸಲು ಸಹಾಯ ಮಾಡಬಹುದು ಎಂದು ನಾವು ನಂಬುತ್ತೇವೆ.</string>

        <string name="about_mission_title">🎯 ನಮ್ಮ ಧಾತುರೂಪ</string>
        <string name="about_mission_text">• ರೈತರನ್ನು ಫಸಲ್ ರೋಗುಗಳನ್ನು ವೇಗವಾಗಿ ಗುರುತಿಸಲು ಸಹಾಯ ಮಾಡುವುದು\n• ಬಹುಸಂಸ್ಕೃತ ಭಾಷೆಗಳಲ್ಲಿ ಪರಿಹಾರಗಳನ್ನು ಒದಗಿಸುವುದು\n• ಫಸಲ್ ಕ್ಷತಿಯಿಂದ ರಕ್ಷಿಸುವುದು ಮತ್ತು ಇಳುವರಿ ಹೆಚ್ಚಿಸುವುದು\n• ಆಧುನಿಕ AI ತಂತ್ರಜ್ಞಾನವನ್ನು ಗ್ರಾಮೀಣ ಪ್ರದೇಶಗಳಿಗೆ ಸರಳ ರೀತಿಯಲ್ಲಿ ತರುವುದು\n• ಪ್ರತಿಯೊಬ್ಬ ರೈತರ ಫಸಲ್ ಆರೋಗ್ಯ ಮೇಲ್ವಿಚಾರಣೆಯನ್ನು ಸುಲಭ ಮಾಡುವುದು</string>

        <string name="about_goals_title">🎯 ನಮ್ಮ ಗುರಿಗಳು</string>
        <string name="about_goals_text">• ರೈತರನ್ನು ಅವರ ಸ್ಮಾರ್ಟ್‌ಫೋನ್‌ಗಳನ್ನು ಬಳಸಿ ಫಸಲ್ ಆರೋಗ್ಯವನ್ನು ಪರಿಶೀಲಿಸಲು ಸಕ್ಷಮ ಮಾಡುವುದು\n• 90% ಕ್ಕಿಂತ ಹೆಚ್ಚಿನ ನಿಖರತೆಯನ್ನು ನೀಡುವುದು\n• ಫಸಲ್ ರೋಗುಗಳನ್ನು ತಡೆಯಲು ಸ್ಪಷ್ಟ ಕ್ರಮಗಳನ್ನು ನೀಡುವುದು\n• ಬಹುಪ್ರದೇಶೀಯ ಭಾಷೆಗಳಲ್ಲಿ ಬೆಂಬಲವನ್ನು ನೀಡುವುದು\n• AI ಮಾದರಿಯನ್ನು ನಿರಂತರವಾಗಿ ಸುಧಾರಿಸುವುದು</string>

        <string name="about_features_title">✅ ಸ್ಮಾರ್ಟ್‌ಲೀಫ್ ಮಾಡಬಹುದಾದ ಕೆಲಸಗಳು</string>
        <string name="about_features_text">• ತತ್ಕ್ಷಣ ಎಲೆಯ ಚಿತ್ರದಿಂದ ರೋಗುಗಳನ್ನು ಗುರುತಿಸುವುದು\n• ವಿವರವಾದ ರೋಗ ಮಾಹಿತಿಯನ್ನು ನೀಡುವುದು\n• ಸರಳ ಮತ್ತು ಸಾಶ್ರಯಿ ಪರಿಹಾರಗಳನ್ನು ಸೂಚಿಸುವುದು\n• ಬಹುಸಂಸ್ಕೃತ ಭಾಷೆಗಳಲ್ಲಿ ಬೆಂಬಲವನ್ನು ನೀಡುವುದು\n• ಎಲ್ಲರಿಗೆ ಸಂಪೂರ್ಣ ಉಚಿತ ಮತ್ತು ಸರಳವಾಗಿರುವುದು\n• ಇಂಟರನೆಟ್ ಇಲ್ಲದೆ ಕೆಲಸ ಮಾಡುವುದು\n• ಸ್ಕ್যಾನ್ ಇತಿಹಾಸವನ್ನು ಉಳಿಸಿಕೊಳ್ಳುವುದು</string>

        <string name="about_why_title">📖 ನಾವು ಇದನ್ನು ಏಕೆ ಹೇಳಿದೆವು</string>
        <string name="about_why_text">ಪ್ರತಿ ವರ್ಷ ಅನೇಕ ರೈತರು ತಮ್ಮ ಫಸಲುಗಳನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತಾರೆ ಏಕೆಂದರೆ ಅವರು ರೋಗುಗಳನ್ನು ವೇಗವಾಗಿ ಗುರುತಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಸಾಂಪ್ರದಾಯಿಕ ಮಾರ್ಗಗಳಲ್ಲಿ ತಜ್ಞ ಸಲಹೆ ವೆಚ್ಚದಾಯಕ ಮತ್ತು ಸಮಯ ವ್ಯರ್ಥವಾಗುವುದು. ಸ್ಮಾರ್ಟ್‌ಲೀಫ್ ತ್ವರಿತ, ನಿಖರ ಮತ್ತು ಸುಲಭ ಗುರುತಿಸುವಿಕೆಗಾಗಿ ನಿರ್ಮಿತವಾಗಿದೆ.</string>

        <string name="about_helps_title">🔹 ಇದು ರೈತರಿಗೆ ಹೇಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ</string>
        <string name="about_helps_text">• ರೋಗುಗಳನ್ನು ವೇಗವಾಗಿ ಗುರುತಿಸಿ ಫಸಲುಗಳನ್ನು ರಕ್ಷಿಸುವುದು\n• ಗ್ರಾಮೀಣ ಪ್ರದೇಶಗಳಲ್ಲಿ ಕೆಲಸ ಮಾಡುವುದು\n• ಸ್ಥಳೀಯ ಭಾಷೆಗಳಿಗೆ ಬೆಂಬಲವನ್ನು ನೀಡುವುದು\n• ರೈತರ ಆದಾಯ ಹೆಚ್ಚಿಸಲು ಸಹಾಯ ಮಾಡುವುದು\n• ವೆಚ್ಚದಾಯಕ ಸಲಹಾಕಾರರ ಅವಲಂಬನೆಯನ್ನು ಕಡಿಮೆ ಮಾಡುವುದು\n• 24/7 ಮೇಲ್ವಿಚಾರಣಾ ಸೌಕರ್ಯವನ್ನು ನೀಡುವುದು\n• ರೈತರಿಗೆ ಜ್ಞಾನವನ್ನು ನೀಡುವುದು</string>

        <string name="about_commitment_title">🌱 ನಮ್ಮ ಬದ್ಧತೆ</string>
        <string name="about_commitment_text">ಸ್ಮಾರ್ಟ್‌ಲೀಫ್ ರೈತರ ತೃಪ್ತಿಗೆ ಬದ್ಧವಾಗಿರುತ್ತದೆ. ನಾವು ನಿಯಮಿತವಾಗಿ ಮಾದರಿಯನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡುತ್ತೇವೆ ಮತ್ತು ಬಳಕೆದಾರರ ಪ್ರತಿಕ್ರಿಯೆಗಳನ್ನು ಕೇಳುತ್ತೇವೆ.</string>

        <string name="about_community_title">💚 ನಮ್ಮ ಸಮುದಾಯಕ್ಕೆ ಸೇರಿಕೊಳ್ಳಿ</string>
        <string name="about_community_text">ಸ್ಮಾರ್ಟ್‌ಲೀಫ್ ಪರಿವಾರದ ಭಾಗ ಆಗಿ ಕೃಷಿಯನ್ನು ಸ್ಮಾರ್ಟ್ ಮಾಡಲು ಸಹಾಯ ಮಾಡಿ. ನಿಮ್ಮ ಪ್ರತಿಕ್ರಿಯೆ ನಮ್ಮನ್ನು ಉತ್ತಮವಾಗಿ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತದೆ.</string>
